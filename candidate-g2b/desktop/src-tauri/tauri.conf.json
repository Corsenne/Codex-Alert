{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finish Alert G2B TEST",
  "version": "1.2.0",
  "identifier": "com.corsenne.finishalertdesktop.g2btest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finish Alert G2B TEST",
        "width": 420,
        "height": 124,
        "minWidth": 320,
        "minHeight": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "fullscreen": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png"
    ]
  }
}
