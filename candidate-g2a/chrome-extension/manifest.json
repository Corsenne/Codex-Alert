{
  "manifest_version": 3,
  "name": "ChatGPT Finish Alert — Desktop Edition",
  "version": "1.2.0",
  "description": "ChatGPT / Codex 通知統合候補。通知音はWindows側の順番待ちキューで1件ずつ再生。",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "storage",
    "offscreen",
    "nativeMessaging"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "ChatGPT Finish Alert",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ]
}
