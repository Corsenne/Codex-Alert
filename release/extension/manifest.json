{
  "manifest_version": 3,
  "name": "ChatGPT Finish Alert — Desktop Edition",
  "version": "1.2.0",
  "description": "ChatGPTとCodexの回答完了をWindowsで1件ずつ通知する統合版。",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "windows",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Finish Alert",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
